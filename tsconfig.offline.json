{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "outDir": "dist-offline", "rootDir": "src"
  },
  "include": ["src/main-offline.ts", "src/game/config/**/*.ts", "src/game/systems/**/*.ts", "src/game/ui/**/*.ts", "src/game/renderers/CanvasRenderer.ts", "src/services/**/*.ts"]
}
